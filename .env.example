# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Shows the "sample content" banner at the top of every page while we wait on real content.
NEXT_PUBLIC_PREVIEW_MODE=true

# Public site address, used for links in emails and for search engines.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email sending (Resend). Leave blank in development: emails are then printed to the
# terminal. Without these, a deployed site tells visitors to email or text instead.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=bookings@shotsbydunz.ca
BOOKING_TO_EMAIL=

# Bookings database (Supabase). Project Settings, API Keys. The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Who can sign in to the bookings dashboard at /admin. Comma-separated emails.
ADMIN_EMAILS=

# Vercel sends this with its daily call to /api/cron/keepalive. Without it the call only keeps
# Supabase awake; with it, it also runs the 12-month privacy clean-up. Set it in Vercel only.
CRON_SECRET=

# Cloudflare Turnstile bot check (optional). Set both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
