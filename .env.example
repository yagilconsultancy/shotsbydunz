# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Shows the "sample content" banner at the top of every page while we wait on real content.
NEXT_PUBLIC_PREVIEW_MODE=true

# Public site address, used for links in emails and for search engines.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email sending (Resend). Leave blank in development: form submissions are then only
# printed to the terminal instead of emailed.
# Without these, a deployed site tells visitors to email or text instead of sending.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
BOOKING_TO_EMAIL=

# Cloudflare Turnstile bot check (optional). Set both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
